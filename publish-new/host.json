{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      },
      "enableLiveMetrics": true,
      "enableDependencyTracking": true,
      "enablePerformanceCountersCollection": true
    },
    "logLevel": {
      "default": "Warning",
      "Function": "Information",
      "Microsoft": "Warning",
      "Azure.Core": "Error",
      "Azure.Storage": "Warning",
      "Host.Results": "Information",
      "Host.Aggregator": "Warning"
    }
  },

  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxConcurrentRequests": 10,
      "maxOutstandingRequests": 100,
      "dynamicThrottlesEnabled": false,
      "customHeaders": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type, Authorization"
      }
    },
    "queues": {
      "maxPollingInterval": "00:00:00.500",
      "visibilityTimeout": "00:03:00",
      "batchSize": 8,
      "maxDequeueCount": 3,
      "newBatchThreshold": 4
    },
    "blobs": {
      "maxDegreeOfParallelism": 8
    }
  },

  "functionTimeout": "00:05:00",

  "healthMonitor": {
    "enabled": true,
    "healthCheckInterval": "00:01:00",
    "healthCheckWindow": "00:05:00",
    "healthCheckThreshold": 3
  },

  "singleton": {
    "lockPeriod": "00:00:15",
    "listenerLockPeriod": "00:00:30",
    "listenerLockRecoveryPollingInterval": "00:00:15",
    "lockAcquisitionTimeout": "00:00:30",
    "lockAcquisitionPollingInterval": "00:00:02"
  },

  "concurrency": {
    "dynamicConcurrencyEnabled": true,
    "maximumFunctionConcurrency": 16
  },

  "retry": {
    "strategy": "exponentialBackoff",
    "maxRetryCount": 3,
    "minimumInterval": "00:00:01",
    "maximumInterval": "00:00:15"
  }
}

