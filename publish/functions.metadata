[
  {
    "name": "ProcessBlobFile",
    "scriptFile": "SmartStudyFunc.dll",
    "entryPoint": "SmartStudyFunc.ProcessBlobFile.Run",
    "language": "dotnet-isolated",
    "properties": {
      "IsCodeless": false
    },
    "bindings": [
      {
        "name": "blobStream",
        "direction": "In",
        "type": "blobTrigger",
        "path": "textbooks/{className}/{subject}/{chapter}/{name}",
        "connection": "AzureWebJobsStorage",
        "properties": {
          "supportsDeferredBinding": "True"
        }
      }
    ]
  },
